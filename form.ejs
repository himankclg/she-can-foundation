<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Get In Touch - She Can Foundation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom subtle blob animation for background */
        .blob {
            animation: blob 7s infinite;
        }
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        .animation-delay-2000 { animation-delay: 2s; }
        .animation-delay-4000 { animation-delay: 4s; }
    </style>
</head>
<body class="bg-red-50 text-slate-800 antialiased overflow-x-hidden">

    <!-- Header / Navigation -->
    <header class="fixed w-full top-0 z-50 bg-white/80 backdrop-blur-lg border-b border-red-100 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Spacer where the Logo used to be -->
                <div class="flex-shrink-0"></div>

                <!-- Desktop Navigation -->
                <nav class="hidden md:flex items-center space-x-8">
                    <!-- Functional Home Button (Links to index.html) -->
                    <a href="/" class="text-slate-500 font-medium hover:text-red-600 transition-colors duration-200 relative group">
                        Home
                        <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-red-500 rounded-full transition-transform duration-300 transform scale-x-0 group-hover:scale-x-100"></span>
                    </a>
                    
                    <!-- Functional About Us Button (Links to about.html) -->
                    <a href="/about" class="text-slate-500 font-medium hover:text-red-600 transition-colors duration-200 relative group">
                        About Us
                        <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-red-500 rounded-full transition-transform duration-300 transform scale-x-0 group-hover:scale-x-100"></span>
                    </a>

                    <!-- Inactive Contact Us Button with Hover Effects -->
                    <a href="/contact"  class="text-slate-500 font-medium hover:text-red-600 transition-colors duration-200 relative group cursor-pointer">
                        Contact Us
                        <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-red-500 rounded-full transition-transform duration-300 transform scale-x-0 group-hover:scale-x-100"></span>
                    </a>
                    
                    <!-- Form Button (Active Visual State) -->
                    <a href="/form" class="ml-4 inline-flex items-center justify-center px-6 py-2.5 border border-transparent rounded-full shadow-md text-sm font-semibold text-white bg-red-600 hover:bg-red-700 hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 cursor-pointer">
                        Form
                    </a>
                </nav>

                <!-- Mobile menu button (visual only for aesthetics) -->
                <div class="md:hidden flex items-center">
                    <button type="button" class="text-slate-500 hover:text-slate-600 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main id="contact-form" class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
        
        <!-- Decorative Background Elements -->
        <div class="absolute top-0 -left-4 w-72 h-72 bg-red-200 rounded-full mix-blend-multiply filter blur-2xl opacity-40 blob"></div>
        <div class="absolute top-0 -right-4 w-72 h-72 bg-rose-200 rounded-full mix-blend-multiply filter blur-2xl opacity-45 blob animation-delay-2000"></div>
        <div class="absolute -bottom-8 left-20 w-72 h-72 bg-orange-100 rounded-full mix-blend-multiply filter blur-2xl opacity-40 blob animation-delay-4000"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-12 lg:py-24 w-full">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                
                <!-- Form Container Column -->
                <div class="order-2 lg:order-1 bg-white/70 backdrop-blur-md border border-red-100 rounded-3xl p-8 sm:p-10 shadow-xl transition-all duration-300">
                    
                    <!-- Actual Form Element -->
                    <form id="sheCanForm" onsubmit="handleFormSubmit(event)" class="space-y-6 transition-all duration-500">
                        <div class="space-y-2">
                            <h2 class="text-3xl font-extrabold text-slate-800 tracking-tight">Connect With Us</h2>
                            <p class="text-slate-500 text-sm">We'd love to hear from you. Fill out the form below and our team will get back to you shortly.</p>
                        </div>

                        <!-- Name Input -->
                        <div>
                            <label for="name" class="block text-sm font-semibold text-slate-700 mb-1.5">Full Name</label>
                            <input 
                                type="text" 
                                id="name" 
                                name="name" 
                                required
                                placeholder="Your Name"
                                class="w-full px-4 py-3 rounded-xl border border-red-100 bg-white/80 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 text-slate-800 placeholder-slate-400 transition-all duration-200"
                            >
                        </div>

                        <!-- Email Input -->
                        <div>
                            <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">Email Address</label>
                            <input 
                                type="email" 
                                id="email" 
                                name="email" 
                                required
                                placeholder="you@example.com"
                                class="w-full px-4 py-3 rounded-xl border border-red-100 bg-white/80 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 text-slate-800 placeholder-slate-400 transition-all duration-200"
                            >
                        </div>

                        <!-- Message Input -->
                        <div>
                            <label for="message" class="block text-sm font-semibold text-slate-700 mb-1.5">Your Message</label>
                            <textarea 
                                id="message" 
                                name="message" 
                                rows="4" 
                                required
                                placeholder="How can we help or collaborate?"
                                class="w-full px-4 py-3 rounded-xl border border-red-100 bg-white/80 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 text-slate-800 placeholder-slate-400 transition-all duration-200 resize-none"
                            ></textarea>
                        </div>

                        <!-- Submit Button -->
                        <button 
                            type="submit" 
                            class="w-full py-4 px-6 rounded-xl shadow-md text-base font-bold text-white bg-red-600 hover:bg-red-700 hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200 cursor-pointer flex items-center justify-center space-x-2"
                        >
                            <span>Send Message</span>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </button>
                    </form>

                    <!-- Success Message (Hidden by default, shown dynamically upon submission) -->
                    <div id="successState" class="hidden flex flex-col items-center justify-center text-center py-12 space-y-6 animate-fade-in">
                        <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-2 shadow-inner">
                            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div class="space-y-2">
                            <h3 class="text-2xl font-extrabold text-slate-800">Thank You!</h3>
                            <p class="text-slate-600 max-w-sm mx-auto">Your message has been successfully received. The team at She Can Foundation will respond to you soon.</p>
                        </div>
                        <button 
                            onclick="resetForm()" 
                            class="mt-4 px-6 py-2 rounded-full border border-red-200 hover:border-red-400 text-sm font-semibold text-red-600 transition-all duration-200 hover:bg-red-50 cursor-pointer"
                        >
                            Send Another Message
                        </button>
                    </div>

                </div>

                <!-- Image Content Column -->
                <div class="order-1 lg:order-2 flex justify-center lg:justify-end relative">
                    <div class="relative w-full max-w-sm sm:max-w-md lg:max-w-lg xl:max-w-xl">
                        <!-- Decorative ring behind image -->
                        <div class="absolute inset-0 rounded-[2.5rem] bg-gradient-to-tr from-red-200 to-rose-100 transform rotate-3 scale-105 -z-10"></div>
                        
                        <!-- Main Image -->
                        <img 
                            src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=375,fit=crop/Aq2NJ23MzBH2rx2j/she-YlenJon1O7ieeEoa.jpg" 
                            alt="A person smiling warmly, representing hope and community" 
                            class="rounded-[2rem] shadow-2xl w-full h-auto object-cover border-4 border-white aspect-[4/5] sm:aspect-square lg:aspect-[4/5]"
                        >
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- Simple state script -->
    <script>
        function handleFormSubmit(event) {
            event.preventDefault();
            
            // Get form and success state elements
            const form = document.getElementById('sheCanForm');
            const successState = document.getElementById('successState');
            
            // Hide the form and show success message
            form.classList.add('hidden');
            successState.classList.remove('hidden');
        }

        function resetForm() {
            const form = document.getElementById('sheCanForm');
            const successState = document.getElementById('successState');
            
            // Reset input values
            form.reset();
            
            // Show the form and hide success message
            successState.classList.add('hidden');
            form.classList.remove('hidden');
        }
    </script>

</body>
</html>