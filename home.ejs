<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>She can foundation</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom subtle blob animation for background */
        .blob {
            animation: blob 7s infinite;
        }
        @keyframes blob {
            0% { transform: translate(0px, 0px) scale(1); }
            33% { transform: translate(30px, -50px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
            100% { transform: translate(0px, 0px) scale(1); }
        }
        .animation-delay-2000 { animation-delay: 2s; }
        .animation-delay-4000 { animation-delay: 4s; }
    </style>
</head>
<body class="bg-red-50 text-slate-800 antialiased overflow-x-hidden">

    <!-- Header / Navigation -->
    <header class="fixed w-full top-0 z-50 bg-white/80 backdrop-blur-lg border-b border-red-100 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Spacer where the Logo used to be -->
                <div class="flex-shrink-0"></div>

                <!-- Desktop Navigation -->
                <nav class="hidden md:flex items-center space-x-8">
                    <!-- Functional Home Button -->
                    <a href="http://localhost:8080/" class="text-red-600 font-semibold hover:text-red-500 transition-colors duration-200 relative group">
                        Home
                        <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-red-500 rounded-full transition-transform duration-300 transform scale-x-100"></span>
                    </a>
                    
                    <!-- Inactive Buttons with Hover Effects -->
                    <a href="/about" class="text-slate-500 font-medium hover:text-red-600 transition-colors duration-200 relative group cursor-pointer">
                        About Us
                        <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-red-500 rounded-full transition-transform duration-300 transform scale-x-0 group-hover:scale-x-100"></span>
                    </a>
                    <a href="/contact"  class="text-slate-500 font-medium hover:text-red-600 transition-colors duration-200 relative group cursor-pointer">
                        Contact Us
                        <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-red-500 rounded-full transition-transform duration-300 transform scale-x-0 group-hover:scale-x-100"></span>
                    </a>
                    
                    <!-- Form Button -->
                    <a href="/form"  class="ml-4 inline-flex items-center justify-center px-6 py-2.5 border border-transparent rounded-full shadow-sm text-sm font-semibold text-white bg-red-600 hover:bg-red-700 hover:shadow-md transform hover:-translate-y-0.5 transition-all duration-200 cursor-pointer">
                        Form
                    </a>
                </nav>

                <!-- Mobile menu button (visual only for aesthetics) -->
                <div class="md:hidden flex items-center">
                    <button type="button" class="text-slate-500 hover:text-slate-600 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main id="home" class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
        
        <!-- Decorative Background Elements -->
        <div class="absolute top-0 -left-4 w-72 h-72 bg-red-200 rounded-full mix-blend-multiply filter blur-2xl opacity-40 blob"></div>
        <div class="absolute top-0 -right-4 w-72 h-72 bg-rose-200 rounded-full mix-blend-multiply filter blur-2xl opacity-45 blob animation-delay-2000"></div>
        <div class="absolute -bottom-8 left-20 w-72 h-72 bg-orange-100 rounded-full mix-blend-multiply filter blur-2xl opacity-40 blob animation-delay-4000"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-12 lg:py-24">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-8 items-center">
                
                <!-- Text Content -->
                <div class="flex flex-col justify-center space-y-6 text-center lg:text-left order-2 lg:order-1">
                    <div class="inline-flex items-center justify-center lg:justify-start space-x-2">
                        <span class="px-3 py-1 rounded-full bg-red-100 text-red-800 text-sm font-semibold tracking-wide uppercase">Our Mission</span>
                    </div>
                    
                    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold text-slate-900 tracking-tight leading-[1.1]">
                        <span class="block text-slate-800">Together we can</span>
                        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-rose-500">change the world</span>
                    </h1>
                </div>

                <!-- Image Content -->
                <div class="order-1 lg:order-2 flex justify-center lg:justify-end relative">
                    <div class="relative w-full max-w-sm sm:max-w-md lg:max-w-lg xl:max-w-xl">
                        <!-- Decorative ring behind image -->
                        <div class="absolute inset-0 rounded-[2.5rem] bg-gradient-to-tr from-red-200 to-rose-100 transform rotate-3 scale-105 -z-10"></div>
                        
                        <!-- Main Image -->
                        <img 
                            src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=375,fit=crop/Aq2NJ23MzBH2rx2j/she-YlenJon1O7ieeEoa.jpg" 
                            alt="A person smiling warmly, representing hope and community" 
                            class="rounded-[2rem] shadow-2xl w-full h-auto object-cover border-4 border-white aspect-[4/5] sm:aspect-square lg:aspect-[4/5]"
                        >
                    </div>
                </div>

            </div>
        </div>
    </main>

</body>
</html>